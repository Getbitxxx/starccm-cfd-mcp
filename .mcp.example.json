{
  "mcpServers": {
    "starccm-cfd": {
      "command": "/absolute/path/to/starccm-cfd-mcp/.venv/bin/python",
      "args": [
        "/absolute/path/to/starccm-cfd-mcp/scripts/server_gateway.py"
      ],
      "env": {
